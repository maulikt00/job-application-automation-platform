# Copy this file to .env and fill in real values.
# .env is git-ignored -- never commit real secrets.

# --- Database ---
JAAP_DATABASE_URL=sqlite:///./data/jaap.db

# --- AI Providers (Phase 3) ---
# Only required once the corresponding provider is enabled.
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- Browser Automation (Phase 2) ---
# Set to false locally to watch the browser interactively while debugging.
JAAP_HEADLESS=true

# --- Application ---
JAAP_ENV=development
JAAP_LOG_LEVEL=INFO
JAAP_LOG_DIR=logs
